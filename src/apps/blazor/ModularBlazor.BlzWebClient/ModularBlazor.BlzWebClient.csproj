<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Modular Blazor WebAssembly host for the WebApi platform:
      * signs in with the OpenIddict identity service (Authorization Code + PKCE) and sends its access token to the
        YARP gateway, which fronts every WebApi pool;
      * loads its client modules (layouts, themes, pages) from the WebApi's client-modules core module: the manifest
        (api/client-modules/manifest) says which ones this user gets and when (startup, lazy, preload);
      * manages the host (WebApi) modules through WebApi.Client (install, activate, deactivate, unload, uninstall),
        and the client modules through WebApi.Modules.Core.ClientModules.Client (/client-modules);
      * uses MudTail (shipped by the Layouts.Default module) for its tables, forms and buttons.
    It replaces ModularBlazor.Client, which talks to the obsolete api/ModularBlazor.Host.
  -->

  <PropertyGroup>
    <!-- Modules are loaded at runtime and may call any framework API, so the host must not
         trim the framework. Keep these off, otherwise modules can hit MissingMethodException. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AssemblyName>$(SoftSquarePrefix).ModularBlazor.BlzWebClient</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).ModularBlazor.BlzWebClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contracts modules compile against (ICurrentUserService, IAuthenticationService, IModuleNavigation, ...). -->
    <ProjectReference Include="..\..\..\ModularBlazor.Abstractions\ModularBlazor.Abstractions.csproj" />
    <!-- Typed client of the WebApi host's module management API (/api/admin/modules, /api/pool, /health). -->
    <ProjectReference Include="..\..\..\WebApi\WebApi.Client\WebApi.Client.csproj" />
    <!-- Typed client of the client-modules core module (/api/client-modules: upload, install, settings, versions). -->
    <ProjectReference Include="..\..\..\WebApi\Modules\Core.Clients\WebApi.Modules.Core.ClientModules.Client\WebApi.Modules.Core.ClientModules.Client.csproj" />
  </ItemGroup>

  <!-- ================================================================ node-app (wwwroot/js/app.js) -->

  <PropertyGroup>
    <!-- node-app is a separate toolchain; keep its sources and node_modules out of the .NET globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node-app/**</DefaultItemExcludes>
    <!-- wwwroot/js/app.js is built by node-app (vite). dotnet build compiles it only when asked:
         dotnet build -p:BuildNodeApp=true   (otherwise the committed wwwroot/js/app.js is used). -->
    <BuildNodeApp Condition="'$(BuildNodeApp)' == ''">false</BuildNodeApp>
  </PropertyGroup>

  <ItemGroup>
    <None Include="node-app\package.json;node-app\src\**\*" />
  </ItemGroup>

  <Target Name="BuildNodeApp" BeforeTargets="BeforeBuild" Condition="'$(BuildNodeApp)' == 'true'">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)/node-app" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/node-app" />
  </Target>

  <!-- Client modules are not part of this app: the WebApi ships them (CoreClientModules, built from modules/client)
       and serves them through api/client-modules; admins upload more on the /client-modules page. -->

</Project>
