@inject ModuleManager Modules
@inject NavigationManager NavManager
@inject ActiveModuleService ModuleService
@inject JSRuntime JS
@implements IDisposable

<LayoutView Layout="Modules.ResolveLayout(LayoutKey)">@ChildContent</LayoutView>

@code {
    /// <summary>Key of a registered layout; null uses the default layout.</summary>
    [Parameter] public string? LayoutKey { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

  protected override void OnInitialized()
  {
    NavManager.LocationChanged += HandleNavigationCleanup;
  }

  private void HandleNavigationCleanup(object sender, LocationChangedEventArgs e)
  {
    // When navigating away, completely purge the loaded style variables
    ModuleService.ClearActiveModule();

    // Tell your JS engine to drop module references to clear memory
    _ = JS.InvokeVoidAsync("moduleHost.unloadModules");
  }

  public void Dispose()
  {
    NavManager.LocationChanged -= HandleNavigationCleanup;
  }
}
