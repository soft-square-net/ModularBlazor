@using System.Text
@using Microsoft.JSInterop
@inject ActiveModuleService ModuleService
@inject IJSRuntime JS
@implements IDisposable

<!-- This component renders in-memory assets using normal HTML lifecycles -->
@if (!string.IsNullOrEmpty(ModuleService.CurrentModuleId))
{
  <!-- Grouped styles loop -->
  @foreach (var stylePath in ModuleService.ActiveStyles)
  {
    var key = stylePath.Replace('\\', '/').TrimStart('/');
    if (ModuleService.ActiveAssets.TryGetValue(key, out var cssBytes))
    {
      <style id="virtual-style-@ModuleService.CurrentModuleId-@key">
        @Encoding.UTF8.GetString(cssBytes)
      </style>
    }
  }
}

@code {
  protected override void OnInitialized()
  {
    ModuleService.OnChange += OnModuleStateChanged;
  }

  private async void OnModuleStateChanged()
  {
    await InvokeAsync(StateHasChanged);

    // Whenever the module switches, trigger JavaScript execution for scripts
    if (!string.IsNullOrEmpty(ModuleService.CurrentModuleId))
    {
      foreach (var scriptPath in ModuleService.ActiveScripts)
      {
        var key = scriptPath.Replace('\\', '/').TrimStart('/');
        if (ModuleService.ActiveAssets.TryGetValue(key, out var jsBytes))
        {
          // Pass bytes to JavaScript engine safely
          await JS.InvokeVoidAsync("moduleHost.loadScriptFromBytes", ModuleService.CurrentModuleId, jsBytes);
        }
      }
    }
  }

  public void Dispose()
  {
    ModuleService.OnChange -= OnModuleStateChanged;
  }
}
