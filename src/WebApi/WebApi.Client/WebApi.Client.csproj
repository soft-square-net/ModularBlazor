<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Typed C# client for the WebApi host's own HTTP API, generated by NSwag from the host's saved OpenAPI document
    (../openapi/webapi.json, written by src/WebApi/scripts/Export-ModuleOpenApi.ps1 -HostDocument):
    ModulesClient (/api/admin/modules: install, activate, deactivate, unload, settings, uninstall), PoolClient, HealthClient.
    Each module's own endpoints have their own client next to the module (WebApi.Modules.<Name>.Client).

    - Versioned with the host: change an endpoint, re-export the document, build; the client follows.
    - No runtime dependencies beyond the BCL (HttpClient, System.Text.Json), so the Blazor app (or an admin client
      module) can reference it without the host providing anything.
    - Not a server project: it references nothing from the WebApi and runs in the browser.
  -->

  <PropertyGroup>
    <ModuleOpenApiDocument>$(MSBuildProjectDirectory)/../openapi/webapi.json</ModuleOpenApiDocument>
    <GeneratedClient>$(MSBuildProjectDirectory)/Generated/WebApiClient.g.cs</GeneratedClient>
    <!-- When the file already exists, the default Compile glob picks it up; otherwise the target adds it after generating. -->
    <GeneratedClientExisted>$([System.IO.File]::Exists('$(GeneratedClient)'))</GeneratedClientExisted>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild" Version="14.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nswag.json;$(ModuleOpenApiDocument)" />
  </ItemGroup>

  <!-- Regenerates the client only when the document or the settings changed (incremental: Inputs/Outputs). The output
       is committed, so the client builds without running NSwag and API changes show up in code review. -->
  <Target Name="GenerateWebApiClient" BeforeTargets="BeforeBuild;CoreCompile"
          Inputs="$(ModuleOpenApiDocument);$(MSBuildProjectDirectory)/nswag.json" Outputs="$(GeneratedClient)">
    <Exec Command="$(NSwagExe_Net100) run nswag.json /variables:Document=&quot;$(ModuleOpenApiDocument)&quot;,Output=&quot;$(GeneratedClient)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" />
    <ItemGroup Condition="'$(GeneratedClientExisted)' != 'True'">
      <Compile Include="$(GeneratedClient)" />
    </ItemGroup>
  </Target>

</Project>
