{
  "openapi": "3.1.1",
  "info": {
    "title": "Shifts",
    "description": "Newsroom shifts: sections, rota (Manager, Desk, Editor), check-out; the rota becomes time-windowed grants.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/shifts/sections": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListSections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SectionDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_AddSection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}": {
      "put": {
        "tags": [
          "Shifts"
        ],
        "summary": "Changing the categories rewrites the grants of the section's published shifts that have not ended.",
        "operationId": "Shifts_UpdateSection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}/settings": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Effective AutoAssignDelay and CheckoutGrace: the section's override, else the module's settings.",
        "operationId": "Shifts_GetSectionSettings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionSettings"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/mine": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Your running and upcoming shifts (next 7 days).",
        "operationId": "Shifts_ListMine",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/overdue": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Published shifts past their end that nobody checked out (for the workflow's automatic check-out).",
        "operationId": "Shifts_ListOverdue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListShifts",
        "parameters": [
          {
            "name": "sectionId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Plans a shift with its rota (exactly one Manager). Nothing is granted until it is published.",
        "operationId": "Shifts_AddShift",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_GetShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_UpdateShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_DeleteShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/automation": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Shift clock and section-specific assignment/check-out timers for the workflow service.",
        "operationId": "Shifts_GetShiftAutomation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftAutomationInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/publish": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Writes the rota's grants: each member's role permissions on the section's categories, valid for the shift only.",
        "operationId": "Shifts_PublishShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/check-out": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Handover: the whole shift checks out and every member's grants end now (the shift's manager, or a shift admin).",
        "operationId": "Shifts_CheckOutShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/members/{userId}/check-out": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "One member leaves early; their grants end now (themselves, the shift's manager, or a shift admin).",
        "operationId": "Shifts_CheckOutMember",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RotaEntry": {
        "required": [
          "userId",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ShiftRole"
          }
        }
      },
      "RotaMemberDto": {
        "required": [
          "userId",
          "role",
          "checkedOutAt",
          "accessEnds"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ShiftRole"
          },
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "accessEnds": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SectionDto": {
        "required": [
          "id",
          "name",
          "categories",
          "autoAssignDelayMinutes",
          "checkoutGraceMinutes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoAssignDelayMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "checkoutGraceMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "SectionRequest": {
        "required": [
          "name",
          "categories",
          "autoAssignDelayMinutes",
          "checkoutGraceMinutes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoAssignDelayMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "checkoutGraceMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "SectionSettings": {
        "required": [
          "sectionId",
          "autoAssignDelay",
          "checkoutGrace"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "autoAssignDelay": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "checkoutGrace": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          }
        }
      },
      "ShiftAutomationInfo": {
        "required": [
          "shiftId",
          "sectionId",
          "startsAt",
          "endsAt",
          "checkedOutAt",
          "autoAssignDelay",
          "checkoutGrace"
        ],
        "type": "object",
        "properties": {
          "shiftId": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "autoAssignDelay": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "checkoutGrace": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          }
        }
      },
      "ShiftDto": {
        "required": [
          "id",
          "sectionId",
          "section",
          "categories",
          "startsAt",
          "endsAt",
          "published",
          "running",
          "checkedOutAt",
          "checkedOutBy",
          "grantSource",
          "rota"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "section": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "published": {
            "type": "boolean"
          },
          "running": {
            "type": "boolean"
          },
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "checkedOutBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "grantSource": {
            "type": "string"
          },
          "rota": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RotaMemberDto"
            }
          }
        }
      },
      "ShiftRequest": {
        "required": [
          "sectionId",
          "startsAt",
          "endsAt",
          "rota"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "rota": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RotaEntry"
            }
          }
        }
      },
      "ShiftRole": {
        "enum": [
          "Manager",
          "Desk",
          "Editor"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:5090/connect/authorize",
            "tokenUrl": "http://localhost:5090/connect/token",
            "scopes": {
              "openid": "User identity",
              "profile": "User profile",
              "email": "User email",
              "api": "Access to Modular WebApi",
              "offline_access": "Refresh token"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "openid",
        "profile",
        "email",
        "api"
      ]
    }
  ],
  "tags": [
    {
      "name": "Shifts"
    }
  ]
}