{
  "openapi": "3.1.1",
  "info": {
    "title": "Inventory",
    "description": "Sample: stock items per tenant, in each tenant's own database (layers, specifications, repositories).",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/inventory": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Which tenant and database this request was served from.",
        "operationId": "Inventory_GetInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/items": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Stock items by SKU; ?below=N lists only those with fewer than N in stock.",
        "operationId": "Inventory_ListItems",
        "parameters": [
          {
            "name": "below",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StockItemDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Inventory"
        ],
        "operationId": "Inventory_AddItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewStockItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockItemDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/items/{sku}/adjust": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Receives (positive delta) or issues (negative delta) stock; never below zero.",
        "operationId": "Inventory_AdjustItem",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Adjustment"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockItemDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Adjustment": {
        "required": [
          "delta"
        ],
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "InventoryInfo": {
        "required": [
          "tenant",
          "resolvedBy",
          "database",
          "schema",
          "items"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "resolvedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "database": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "NewStockItem": {
        "required": [
          "sku",
          "name",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StockItemDto": {
        "required": [
          "id",
          "sku",
          "name",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:5090/connect/authorize",
            "tokenUrl": "http://localhost:5090/connect/token",
            "scopes": {
              "openid": "User identity",
              "profile": "User profile",
              "email": "User email",
              "api": "Access to Modular WebApi",
              "offline_access": "Refresh token"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "openid",
        "profile",
        "email",
        "api"
      ]
    }
  ],
  "tags": [
    {
      "name": "Inventory"
    }
  ]
}