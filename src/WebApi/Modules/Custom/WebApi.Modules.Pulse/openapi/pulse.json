{
  "openapi": "3.1.1",
  "info": {
    "title": "Pulse",
    "description": "Sample: a BackgroundService and a private ASP.NET Core pipeline.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/pulse/status": {
      "get": {
        "tags": [
          "Pulse"
        ],
        "operationId": "Pulse_GetStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PulseStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PulseStatus": {
        "required": [
          "beats",
          "startedAt",
          "module"
        ],
        "type": "object",
        "properties": {
          "beats": {
            "type": "integer",
            "format": "int64"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "module": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:5090/connect/authorize",
            "tokenUrl": "http://localhost:5090/connect/token",
            "scopes": {
              "openid": "User identity",
              "profile": "User profile",
              "email": "User email",
              "api": "Access to Modular WebApi",
              "offline_access": "Refresh token"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "openid",
        "profile",
        "email",
        "api"
      ]
    }
  ],
  "tags": [
    {
      "name": "Pulse"
    }
  ]
}