{
  "openapi": "3.1.1",
  "info": {
    "title": "Tenancy",
    "description": "Core module: tenant directory admin (tenant store), subscriptions, tenant database provisioning and the current tenant.",
    "version": "2.2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/tenancy/tenants": {
      "get": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Every tenant, as this replica's directory has it.",
        "operationId": "Tenancy_ListTenants",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantInfo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Creates a tenant: provisions its database, writes the tenant store, and every replica reloads; modules then migrate their schemas for it.",
        "operationId": "Tenancy_CreateTenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}": {
      "get": {
        "tags": [
          "Tenancy"
        ],
        "operationId": "Tenancy_GetTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Renames a tenant, changes its host names, or suspends / re-activates it (status Active or Suspended).",
        "operationId": "Tenancy_UpdateTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/current": {
      "get": {
        "tags": [
          "Tenancy"
        ],
        "summary": "The tenant of this request, as the host resolved it (header, host name, then token claim).",
        "operationId": "Tenancy_GetCurrent",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentTenant"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/activate": {
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Re-activates a suspended tenant: its requests are served again on every replica.",
        "operationId": "Tenancy_ActivateTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/suspend": {
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Suspends a tenant: its requests are refused on every replica; its data is kept. Subscriptions never do this by themselves.",
        "operationId": "Tenancy_SuspendTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/provision": {
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Runs the tenant's database provisioning again (idempotent): creates what is missing and re-applies grants. A repair step.",
        "operationId": "Tenancy_ProvisionTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/tenancy/subscriptions": {
      "get": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Every tenant with its current and next subscription and when its covered time ends. NeedsAttention: an Active tenant with nothing covering now, or ending within endingWithinDays (default 30).",
        "operationId": "Tenancy_SubscriptionReport",
        "parameters": [
          {
            "name": "endingWithinDays",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantSubscriptionStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/subscriptions": {
      "get": {
        "tags": [
          "Tenancy"
        ],
        "summary": "The tenant's subscriptions, oldest first, cancelled ones included.",
        "operationId": "Tenancy_ListSubscriptions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantSubscription"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Adds a period [startsAt, endsAt) to the tenant. 409 when it overlaps one that is not cancelled.",
        "operationId": "Tenancy_AddSubscription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSubscription"
              }
            }
          },
          "required": true
        },
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/subscriptions/{subscriptionId}/extend": {
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Moves the subscription's end later (a renewal). 409 when it is cancelled or would overlap the next one.",
        "operationId": "Tenancy_ExtendSubscription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendSubscription"
              }
            }
          },
          "required": true
        },
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenancy/tenants/{id}/subscriptions/{subscriptionId}/cancel": {
      "post": {
        "tags": [
          "Tenancy"
        ],
        "summary": "Cancels the subscription: it stays in the history, no longer counts, and frees its period. The tenant is not suspended.",
        "operationId": "Tenancy_CancelSubscription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelSubscription"
              }
            }
          },
          "required": true
        },
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSubscription"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelSubscription": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateTenantRequest": {
        "required": [
          "id",
          "name",
          "hosts",
          "databaseServer",
          "databaseName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "hosts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "databaseServer": {
            "type": [
              "null",
              "string"
            ]
          },
          "databaseName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CurrentTenant": {
        "required": [
          "tenant",
          "resolvedBy"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/TenantInfo"
          },
          "resolvedBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExtendSubscription": {
        "required": [
          "endsAt"
        ],
        "type": "object",
        "properties": {
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "NewSubscription": {
        "required": [
          "startsAt",
          "endsAt",
          "plan",
          "notes"
        ],
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "plan": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProvisionResult": {
        "required": [
          "tenant",
          "databaseServer",
          "databaseName",
          "created"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "databaseServer": {
            "type": "string"
          },
          "databaseName": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        }
      },
      "SubscriptionState": {
        "enum": [
          "Upcoming",
          "Current",
          "Ended",
          "Cancelled"
        ],
        "type": "string"
      },
      "TenantInfo": {
        "required": [
          "id",
          "name",
          "status",
          "hosts",
          "databaseServer",
          "databaseName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "databaseServer": {
            "type": "string"
          },
          "databaseName": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "TenantStatus": {
        "enum": [
          "Active",
          "Suspended"
        ],
        "type": "string"
      },
      "TenantSubscription": {
        "required": [
          "id",
          "tenantId",
          "startsAt",
          "endsAt",
          "plan",
          "notes",
          "state",
          "createdAt",
          "createdBy",
          "cancelledAt",
          "cancelledBy",
          "cancelReason"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "plan": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/SubscriptionState"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cancelledBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "cancelReason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TenantSubscriptionStatus": {
        "required": [
          "tenantId",
          "tenantName",
          "tenantStatus",
          "current",
          "next",
          "endsAt",
          "daysLeft",
          "lastEndedAt",
          "needsAttention"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "tenantStatus": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "current": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TenantSubscription"
              }
            ]
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TenantSubscription"
              }
            ]
          },
          "endsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "daysLeft": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "lastEndedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "needsAttention": {
            "type": "boolean"
          }
        }
      },
      "UpdateTenantRequest": {
        "required": [
          "name",
          "hosts",
          "status"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "hosts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
