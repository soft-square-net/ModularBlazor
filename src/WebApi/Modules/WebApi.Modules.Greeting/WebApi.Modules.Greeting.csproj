<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sample runtime module. NOT referenced by WebApi: zip the build output (bin/<Configuration>/net10.0)
    and upload it to POST /api/admin/modules while the host is running.
  -->

  <PropertyGroup>
    <!-- Copies private package dependencies (Humanizer) into the output and writes the .deps.json the loader resolves with. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Shared with the host: compile against them, never ship them. -->
    <PackageReference Include="Carter" Version="10.0.0" ExcludeAssets="runtime" />
    <!-- Private dependency: loads into the module's own load context. -->
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WebApi.Contracts\WebApi.Contracts.csproj" />
  </ItemGroup>

</Project>
