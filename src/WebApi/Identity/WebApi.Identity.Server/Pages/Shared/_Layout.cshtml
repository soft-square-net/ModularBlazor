<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Sign in") · Modular Identity</title>
    @* MudTail's stylesheet (src/MudTail/dist/mudtail.css, copied by the build when it exists): the same tokens and
       components as the Blazor clients, so signing in looks like the app that sent you here. *@
    <link rel="stylesheet" href="~/css/mudtail.css" asp-append-version="true" />
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; box-sizing: border-box;
               background: var(--mud-palette-background); color: var(--mud-palette-text-primary);
               font-family: var(--mud-typography-default-family, system-ui, sans-serif); }
        .id-card { width: 100%; max-width: 420px; padding: 32px 28px; border-radius: 12px; box-sizing: border-box; }
        .id-head { text-align: center; margin-bottom: 20px; }
        .id-head h1 { margin: 12px 0 4px; }
        .id-head p { margin: 0; color: var(--mud-palette-text-secondary); }
        .id-logo { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; font-weight: 700;
                   color: var(--mud-palette-primary-contrast, #fff); background: var(--mud-palette-primary); }
        .id-form { display: grid; gap: 4px; }
        .id-block { width: 100%; justify-content: center; }
        .id-stack { display: grid; gap: 10px; margin-top: 16px; }
        .id-error { color: var(--mud-palette-error); margin: 4px 0 12px; }
        .id-muted { color: var(--mud-palette-text-secondary); }
        .id-row { display: flex; align-items: center; justify-content: space-between; margin: 4px 0 16px; }
        .id-toggle { background: transparent; border: 0; cursor: pointer; color: var(--mud-palette-text-secondary); font: inherit; font-size: .8125rem; }
        .id-tenant { justify-content: space-between; text-align: start; }
    </style>
    @* Dark mode follows the system, like MudTail's own theme (data-theme on <html>). *@
    <script>if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');</script>
</head>
<body>
<main class="mud-paper mud-elevation-4 id-card">
    <div class="id-head">
        <span class="id-logo" aria-hidden="true">MB</span>
        <h1 class="mud-typography mud-typography-h5">@(ViewData["Title"] ?? "Sign in")</h1>
        <p class="mud-typography mud-typography-body2">Modular Identity</p>
    </div>
    @RenderBody()
</main>
</body>
</html>
