<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- One migrations project per database provider. The assembly name must match
       DatabaseProviders.MigrationsAssembly(...) in the Infrastructure project. -->
  <PropertyGroup>
    <AssemblyName>$(SoftSquarePrefix).ModularBlazor.Migrations.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).ModularBlazor.Migrations.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../api/_Framework/Infrastructure/Infrastructure.csproj" />
  </ItemGroup>
</Project>
