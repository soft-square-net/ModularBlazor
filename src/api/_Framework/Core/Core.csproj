<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared kernel for the API: contracts and the abstractions every module layer compiles against.
       No infrastructure or web dependencies. -->
  <PropertyGroup>
    <AssemblyName>$(SoftSquarePrefix).ModularBlazor.Core</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).ModularBlazor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time abstractions for the module Domain/Application projects, which reference only Core.
         The runtime wiring (MediatR registration, validators, pipeline, EF repositories) lives in Infrastructure.
         MediatR 12.x is Apache-2.0; 13+ needs a commercial license key. -->
    <PackageReference Include="MediatR" Version="12.*" />
    <PackageReference Include="FluentValidation" Version="12.*" />
    <PackageReference Include="Ardalis.Specification" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="OpenApi\" />
    <Folder Include="Theming\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Share.All\Share.All.csproj" />
  </ItemGroup>

</Project>
