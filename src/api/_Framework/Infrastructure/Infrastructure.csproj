<Project Sdk="Microsoft.NET.Sdk">

  <!-- Implementations of the Core contracts (storage, external services). -->
  <PropertyGroup>
    <AssemblyName>$(SoftSquarePrefix).ModularBlazor.Infrastructure</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).ModularBlazor.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Multi-tenancy (Finbuckle). Bump to 10.x when you move to it; the code targets the 9.x API. -->
    <PackageReference Include="Finbuckle.MultiTenant" Version="9.*" />
    <PackageReference Include="Finbuckle.MultiTenant.AspNetCore" Version="9.*" />
    <PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="9.*" />

    <!-- EF Core 10 providers. Migrations live in src/migrations/*, one project per provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- MySQL via Oracle's provider. Pomelo (the other common MySQL/MariaDB provider) had no EF Core 10 release
         when this was written; to switch, replace this package and the UseMySQL call in DatabaseProviders. -->
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.*" />

    <!-- JWT bearer authentication (access tokens issued by the Auth module). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />

    <!-- Repositories: Ardalis.Specification over EF Core (the abstractions are in Core). Built for EF Core 9;
         its dependency is a minimum (>= 9.0.8), so it resolves against EF Core 10. -->
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" Version="9.*" />

    <!-- CQRS wiring: MediatR registration and validators (MediatR and FluentValidation come from Core). -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />

    <!-- Distributed cache (Redis). -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />

    <!-- NSwag generates the OpenAPI document and serves ReDoc; Scalar renders the same document. -->
    <PackageReference Include="NSwag.AspNetCore" Version="14.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Identity\Tokens\" />
    <Folder Include="Identity\Users\" />
    <Folder Include="Theming\" />
  </ItemGroup>

</Project>
