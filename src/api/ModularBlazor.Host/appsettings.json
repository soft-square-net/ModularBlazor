{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TenantStore": {
    "Provider": "PostgreSql"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "TenantStore": "Host=localhost;Port=5432;Database=ModularBlazorTenants;Username=postgres;Password=postgres",
    "redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "soft.square.net.ModularBlazor",
    "Audience": "soft.square.net.ModularBlazor.Client",
    "SigningKey": "DEV-ONLY-change-me-use-a-long-random-secret-0123456789",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "Seed": {
      "AdminUserName": "admin",
      "AdminEmail": "admin@root.com",
      "AdminPassword": "123Pa$$word!"
    }
  },
  "ElsaHost": {
    "RunMigrations": true,
    "Schema": "Elsa",
    "ApiBasePath": "/elsa/api",
    "RequirePermissions": true
  },
  "ModuleStore": {
    "Path": "assets/modules",
    "AllowUpload": true,
    "MaxUploadMb": 100
  },
  "Media": {
    "Path": "assets/media",
    "MaxVariantMb": 25,
    "MaxOriginalMb": 50,
    "MaxRecipeKb": 1024,
    "MaxVariants": 20,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/avif", "image/gif" ]
  },
  "Documentation": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5000", "https://localhost:5001", "http://localhost:56125", "https://localhost:56124" ]
  },
  "Identity": {
    
    "Roles": [
      {
        "Id": "admin",
        "Permissions": [ "*" ]
      }
    ]
  }
}
