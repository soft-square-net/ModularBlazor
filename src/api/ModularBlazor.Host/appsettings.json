{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TenantStore": {
    "Provider": "PostgreSql"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "TenantStore": "Host=localhost;Port=5432;Database=ModularBlazorTenants;Username=postgres;Password=postgres",
    "redis": "localhost:6379"
  },
  "Documentation": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5000", "https://localhost:5001" ]
  }
}
