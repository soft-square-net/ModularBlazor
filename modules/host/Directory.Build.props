<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Host modules extend ModularBlazor.Host. Each module is three projects (clean architecture):
         <Module>.Domain          entities and aggregates                 -> Core
         <Module>.Application     CQRS commands/queries, validators       -> Core, Domain
         <Module>.Infrastructure  endpoints, DbContext, repositories      -> Application, Domain, framework Infrastructure
       Assembly names: <prefix>.ModularBlazor.Host.Modules.<Module>.<Layer>. -->
  <PropertyGroup>
    <AssemblyName>$(SoftSquarePrefix).ModularBlazor.Host.Modules.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).ModularBlazor.Host.Modules.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/api/_Framework/Core/Core.csproj" />
  </ItemGroup>

  <!-- Infrastructure projects are the web-facing layer (Carter endpoints). -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Infrastructure'))">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Floating on purpose: pin to the Carter version you want to ship. -->
    <PackageReference Include="Carter" Version="*" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/api/_Framework/Infrastructure/Infrastructure.csproj" />
    <Using Include="Carter" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
  </ItemGroup>
</Project>
