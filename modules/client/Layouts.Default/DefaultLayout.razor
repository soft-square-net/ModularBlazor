@using soft.square.net.ModularBlazor.Abstractions.Api
@inherits LayoutComponentBase
@attribute [LayoutKey("default")]
@implements IDisposable
@inject IModuleNavigation Navigation
@inject NavigationManager Nav

<div class="shell-default">
  <aside class="shell-sidebar">
    <a class="brand" href="">Modular Blazor</a>

    <nav>
      <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
      @if (Navigation.Items is not null && Navigation?.Items.Count > 0){
        foreach (var item in Navigation.Items)
        {
          <NavLink href="@item.Href">@item.Title</NavLink>
        }
      }
    </nav>

    <div class="shell-user">
      @if (currentUser is not null)
      {
        <div>currentUser Name <small>(@currentUser.Name)</small></div>
        <a href="login" @onclick="SignOutAsync" @onclick:preventDefault>Sign out</a>
      }
      else
      {
        <a href="login">Sign in</a>
      }
    </div>
  </aside>

  <main class="shell-main">@Body</main>
</div>

@code {
  [Inject] public IAuthenticationService Auth { get; set; } = default!;
  UserInfo? currentUser;
  protected override async Task OnInitializedAsync()
  {
    Navigation.Changed += OnChanged;
    currentUser = await _currentUser.GetUserInfoAsync();
  }

  private void OnChanged() {
    currentUser = _currentUser.GetUserInfoAsync().Result;

      InvokeAsync(StateHasChanged);
  }

  private async Task SignOutAsync()
  {
    await Auth.LogoutAsync();
    Nav.NavigateTo("login");
  }

  public void Dispose()
  {
    Navigation.Changed -= OnChanged;
    Auth.Changed -= OnChanged;
  }
}
