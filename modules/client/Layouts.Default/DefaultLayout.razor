@inherits LayoutComponentBase
@attribute [LayoutKey("default")]
@implements IDisposable
@inject IModuleNavigation Navigation
@inject ICurrentUserService Users
@inject IAuthenticationService Auth

<div class="shell-default">
  <aside class="shell-sidebar">
    <a class="brand" href="">Modular Blazor</a>

    <nav>
      <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
      @foreach (var item in Navigation.Items)
      {
        <NavLink href="@item.Href">@item.Title</NavLink>
      }
    </nav>

    <div class="shell-user">
      @if (_user is not null)
      {
        <div>@_user.Name <small>(@string.Join(", ", _user.Roles))</small></div>
        <a href="login" @onclick="SignOutAsync" @onclick:preventDefault>Sign out</a>
      }
      else
      {
        <a href="login">Sign in</a>
      }
    </div>
  </aside>

  <main class="shell-main">@Body</main>
</div>

@code {
  private UserInfo? _user;

  protected override async Task OnInitializedAsync()
  {
    Navigation.Changed += OnChanged;
    Users.Changed += OnChanged;
    _user = await Users.GetUserInfoAsync();
  }

  // Never block on the async user lookup (.Result freezes WebAssembly): hop onto the renderer and await it there.
  private void OnChanged() => _ = InvokeAsync(async () =>
  {
    _user = await Users.GetUserInfoAsync();
    StateHasChanged();
  });

  private Task SignOutAsync() => Auth.LogoutAsync(); // clears the session and goes to the login page

  public void Dispose()
  {
    Navigation.Changed -= OnChanged;
    Users.Changed -= OnChanged;
  }
}
