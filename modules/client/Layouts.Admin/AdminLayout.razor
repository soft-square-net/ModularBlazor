@using Microsoft.JSInterop
@inherits LayoutComponentBase
@attribute [LayoutKey("admin")]
@inject ICurrentUserService Users
@inject IJSRuntime JS

<div class="shell-admin">
    <header class="topbar">
        <span class="brand">Admin console</span>
        <nav>
            <NavLink href="admin" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="admin/users">Users</NavLink>
            <NavLink href="admin/modules">Modules</NavLink>
        </nav>
        <a href="">&larr; Back to app</a>
        <small>@_user?.Name</small>
    </header>

    <main class="shell-main">@Body</main>
</div>



@code {
  private UserInfo? _user;

  protected override async Task OnInitializedAsync() => _user = await Users.GetUserInfoAsync();
}