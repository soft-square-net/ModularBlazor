@page "/admin/modules"
@using Microsoft.JSInterop
@inject IModuleAdminApi Api
@inject IJSRuntime JS

<PageTitle>Module management</PageTitle>

<h1>Module management</h1>
<p class="hint">
  <strong>Client modules</strong> are what this Blazor app downloads: core modules at startup (then from the browser cache),
  user modules the first time their route is opened. <strong>Host modules</strong> extend the API and take effect after a rebuild.
</p>

@if (_error is not null)
{
  <p class="error-text">@_error</p>
}
@if (_message is not null)
{
  <p class="ok-text">@_message</p>
}

<h2>Client modules</h2>
@if (_registrations is null)
{
  <p class="hint">Loading…</p>
}
else if (_registrations.Count == 0)
{
  <p class="hint">No client modules are registered.</p>
}
else
{
  <table class="modules">
    <thead>
      <tr><th>Module</th><th>Version</th><th>Kind</th><th>Loaded</th><th>Offered to</th><th>Source</th><th>Enabled</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var m in _registrations)
      {
        <tr>
          <td>@m.Id<br /><small>@m.Name</small></td>
          <td>@m.Version</td>
          <td>@m.Kind</td>
          <td>@(m.LoadOnStartup ? "startup (core)" : "on navigation")</td>
          <td>@Audience(m)</td>
          <td>@(m.PackageId is null ? "static file" : $"{m.FileName} ({FormatSize(m.SizeBytes)})")</td>
          <td>
            <input type="checkbox" checked="@m.Enabled" disabled="@_busy"
                   @onchange="e => SetEnabledAsync(m, (bool)(e.Value ?? false))" title="Offer this module to clients" />
          </td>
          <td class="actions">
            <button type="button" @onclick="() => Edit(m)" disabled="@_busy">Edit</button>
            @if (m.PackageId is not null)
            {
              <button type="button" @onclick="() => DownloadAsync(m.PackageId!, m.FileName)" disabled="@_busy">Download</button>
            }
            <button type="button" class="danger" @onclick="() => DeleteAsync(m)" disabled="@_busy">Delete</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}

<h2>Host modules</h2>
@if (_hostPackages is null)
{
  <p class="hint">Loading…</p>
}
else if (_hostPackages.Count == 0)
{
  <p class="hint">No host modules were uploaded.</p>
}
else
{
  <table class="modules">
    <thead>
      <tr><th>Package</th><th>Version</th><th>Kind</th><th>Size</th><th>State</th><th>Enabled</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var p in _hostPackages)
      {
        <tr>
          <td>@p.Name<br /><small>@p.PackageId</small></td>
          <td>@p.Version</td>
          <td>@p.Kind</td>
          <td>@FormatSize(p.SizeBytes)</td>
          <td>
            @if (p.RebuildRequired)
            {
              <span class="badge badge-off">rebuild required</span>
            }
            else if (p.Loaded)
            {
              <span class="badge badge-on">running</span>
            }
            else
            {
              <span class="badge badge-off">not in this build</span>
            }
          </td>
          <td>
            <input type="checkbox" checked="@p.Enabled" disabled="@_busy"
                   @onchange="e => SetHostEnabledAsync(p, (bool)(e.Value ?? false))" />
          </td>
          <td class="actions">
            <button type="button" @onclick="() => DownloadAsync(p.Id, p.FileName)" disabled="@_busy">Download</button>
            <button type="button" class="danger" @onclick="() => DeleteHostAsync(p)" disabled="@_busy">Delete</button>
          </td>
        </tr>
      }
    </tbody>
  </table>

  @if (_hostPackages.Any(p => p.RebuildRequired))
  {
    <p>
      Enabled and disabled host modules apply after the API is rebuilt.
      <button type="button" @onclick="RestartAsync" disabled="@_busy">Restart the API</button>
      <span class="hint">needs the supervisor: <code>scripts/run-host.ps1</code> / <code>.sh</code></span>
    </p>
  }
}

<h2>@(_editId is null ? "Add a module" : $"Edit {_editId}")</h2>
<form class="module-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
  @if (_editId is null)
  {
    <label>Add to
      <select @bind="_form.Target">
        <option value="Client">Client modules (the Blazor app downloads it)</option>
        <option value="Host">Host modules (extends the API)</option>
      </select>
    </label>
  }

  <label>@(_editId is null ? ".dll or .nupkg file" : "New version of the file (optional)")
    <InputFile OnChange="OnFileChosen" accept=".dll,.nupkg" />
  </label>
  @if (_file is not null)
  {
    <p class="hint">@_file.Name (@FormatSize(_file.Size))</p>
  }

  <label>Display name <input @bind="_form.Name" placeholder="optional" /></label>

  @if (_form.Target == "Client")
  {
    <label>Module id <input @bind="_form.Id" placeholder="Module.Reports (empty: from the assembly name)" disabled="@(_editId is not null)" /></label>

    <label class="check"><input type="checkbox" @bind="_form.LoadOnStartup" /> Core module (downloaded at startup, before sign-in)</label>
    <label class="check"><input type="checkbox" @bind="_form.RequiresAuth" /> Requires sign-in</label>
    <label class="check"><input type="checkbox" @bind="_form.Hidden" /> Hidden from the menu</label>
    <label class="check"><input type="checkbox" @bind="_form.Enabled" /> Enabled (offered to clients)</label>

    <label>Route prefixes <input @bind="_form.RoutePrefixes" placeholder="reports, reports/detail" /></label>
    <label>Layout <input @bind="_form.Layout" placeholder="default | admin | auth" /></label>
    <label>Required role <input @bind="_form.RequiredRole" placeholder="admin" /></label>
    <label>Offered to roles <input @bind="_form.AvailableToRoles" placeholder="empty: every signed-in user" /></label>
    <label>Depends on <input @bind="_form.Dependencies" placeholder="Layouts.Admin" /></label>
    <label>Styles <input @bind="_form.Styles" placeholder="css/reports.css" /></label>
    <label>Scripts <input @bind="_form.Scripts" placeholder="empty: js/module.js if the module has one" /></label>
    <label>Menu entry <input @bind="_form.NavTitle" placeholder="title" /></label>
    <label>Menu link <input @bind="_form.NavHref" placeholder="reports" /></label>
    <label>Menu order <input type="number" @bind="_form.NavOrder" /></label>
  }

  <p>
    <button type="submit" disabled="@_busy">@(_busy ? "Working…" : _editId is null ? "Upload" : "Save")</button>
    @if (_editId is not null)
    {
      <button type="button" @onclick="CancelEdit" disabled="@_busy">Cancel</button>
    }
  </p>
</form>

<style>
  .module-form { display: grid; gap: .5rem; max-width: 560px; }
  .module-form label { display: grid; gap: .2rem; font-size: .9rem; }
  .module-form label.check { display: flex; gap: .5rem; align-items: center; }
  .module-form input:not([type=checkbox]), .module-form select { padding: .4rem .5rem; }
  table.modules .actions { white-space: nowrap; }
  table.modules .actions button { margin-right: .25rem; }
  .ok-text { color: #14693a; }
  button.danger { color: #a4262c; }
</style>

@code {
  private sealed class FormModel
  {
    public string Target { get; set; } = "Client";
    public string? Id { get; set; }
    public string? Name { get; set; }
    public bool Enabled { get; set; }
    public bool LoadOnStartup { get; set; }
    public bool RequiresAuth { get; set; } = true;
    public bool Hidden { get; set; }
    public string? RoutePrefixes { get; set; }
    public string? Layout { get; set; }
    public string? RequiredRole { get; set; }
    public string? AvailableToRoles { get; set; }
    public string? Dependencies { get; set; }
    public string? Styles { get; set; }
    public string? Scripts { get; set; }
    public string? NavTitle { get; set; }
    public string? NavHref { get; set; }
    public int NavOrder { get; set; } = 100;
  }

  private const long MaxUploadBytes = 100L * 1024 * 1024;

  private IReadOnlyList<ModuleRegistrationDto>? _registrations;
  private IReadOnlyList<ModulePackageInfo>? _hostPackages;
  private FormModel _form = new();
  private IBrowserFile? _file;
  private string? _editId;
  private string? _error;
  private string? _message;
  private bool _busy;

  protected override Task OnInitializedAsync() => RefreshAsync();

  private async Task RefreshAsync()
  {
    _registrations = await Api.ListRegistrationsAsync();
    _hostPackages = await Api.ListHostPackagesAsync();
  }

  private void OnFileChosen(InputFileChangeEventArgs e) => _file = e.File;

  // Runs an action with the busy flag, shows the server's explanation when it fails, and refreshes the lists.
  private async Task RunAsync(Func<Task<string?>> action)
  {
    _busy = true;
    _error = _message = null;
    try
    {
      _message = await action();
      await RefreshAsync();
    }
    catch (ModuleAdminException ex)
    {
      _error = ex.Message;
    }
    catch (HttpRequestException ex)
    {
      _error = $"The API cannot be reached: {ex.Message}";
    }
    finally
    {
      _busy = false;
    }
  }

  private Task SetEnabledAsync(ModuleRegistrationDto m, bool enabled) => RunAsync(async () =>
  {
    await Api.SetRegistrationEnabledAsync(m.Id, enabled);
    return $"{m.Id} {(enabled ? "is offered to clients" : "is no longer offered")}. Open browsers pick it up on their next page load.";
  });

  private Task SetHostEnabledAsync(ModulePackageInfo p, bool enabled) => RunAsync(async () =>
  {
    await Api.SetPackageEnabledAsync(p.Id, enabled);
    return $"{p.Name} {(enabled ? "enabled" : "disabled")}; it applies after the API is rebuilt.";
  });

  private Task DeleteAsync(ModuleRegistrationDto m) => RunAsync(async () =>
  {
    await Api.DeleteRegistrationAsync(m.Id);
    return $"{m.Id} removed.";
  });

  private Task DeleteHostAsync(ModulePackageInfo p) => RunAsync(async () =>
  {
    await Api.DeletePackageAsync(p.Id);
    return $"{p.Name} removed.";
  });

  private Task RestartAsync() => RunAsync(async () =>
  {
    await Api.RestartHostAsync();
    return "The API is stopping; the supervisor rebuilds and starts it again. Reload this page in a minute.";
  });

  private Task DownloadAsync(string packageId, string? fileName) => RunAsync(async () =>
  {
    var bytes = await Api.DownloadPackageAsync(packageId);
    await JS.InvokeVoidAsync("moduleHost.saveFile", fileName ?? packageId, bytes);
    return null;
  });

  private Task SubmitAsync() => RunAsync(async () =>
  {
    if (_form.Target == "Host")
    {
      if (_file is null) throw new ModuleAdminException("Choose a .dll or .nupkg file.", 400);
      await using var stream = _file.OpenReadStream(MaxUploadBytes);
      var package = await Api.UploadHostPackageAsync(stream, _file.Name, _form.Name);
      ResetForm();
      return $"{package.Name} {package.Version} uploaded. Enable it, then rebuild the API.";
    }

    var request = ToRequest();

    if (_editId is null)
    {
      if (_file is null) throw new ModuleAdminException("Choose a .dll or .nupkg file.", 400);
      await using var stream = _file.OpenReadStream(MaxUploadBytes);
      var added = await Api.RegisterAsync(stream, _file.Name, request);
      ResetForm();
      return $"{added.Id} {added.Version} registered{(added.Enabled ? "" : " (disabled: tick Enabled to offer it)")}.";
    }

    var id = _editId;
    if (_file is not null)
    {
      // A new build of an existing module: the file is replaced, then the metadata edits are applied on top.
      await using var stream = _file.OpenReadStream(MaxUploadBytes);
      await Api.RegisterAsync(stream, _file.Name, new ModuleRegistrationRequest { Id = id });
    }

    await Api.UpdateRegistrationAsync(id, request);
    ResetForm();
    return $"{id} saved.";
  });

  private void Edit(ModuleRegistrationDto m)
  {
    _editId = m.Id;
    _file = null;
    _error = _message = null;
    var nav = m.Nav.FirstOrDefault();
    _form = new FormModel
    {
      Target = "Client",
      Id = m.Id,
      Name = m.Name,
      Enabled = m.Enabled,
      LoadOnStartup = m.LoadOnStartup,
      RequiresAuth = m.RequiresAuth,
      Hidden = m.Hidden,
      RoutePrefixes = string.Join(", ", m.RoutePrefixes),
      Layout = m.Layout,
      RequiredRole = m.RequiredRole,
      AvailableToRoles = string.Join(", ", m.AvailableToRoles),
      Dependencies = string.Join(", ", m.Dependencies),
      Styles = string.Join(", ", m.Styles),
      Scripts = string.Join(", ", m.Scripts),
      NavTitle = nav?.Title,
      NavHref = nav?.Href,
      NavOrder = nav?.Order ?? 100
    };
  }

  private void CancelEdit() => ResetForm();

  private void ResetForm()
  {
    _editId = null;
    _file = null;
    _form = new FormModel();
  }

  private ModuleRegistrationRequest ToRequest() => new()
  {
    Id = _editId ?? _form.Id,
    Name = _form.Name,
    Enabled = _form.Enabled,
    LoadOnStartup = _form.LoadOnStartup,
    RequiresAuth = _form.RequiresAuth,
    Hidden = _form.Hidden,
    RequiredRole = _form.RequiredRole,
    Layout = _form.Layout,
    AvailableToRoles = Split(_form.AvailableToRoles),
    RoutePrefixes = Split(_form.RoutePrefixes),
    Dependencies = Split(_form.Dependencies),
    Styles = Split(_form.Styles),
    Scripts = Split(_form.Scripts),
    Nav = string.IsNullOrWhiteSpace(_form.NavTitle) ? [] : [new ModuleNavItem(_form.NavTitle.Trim(), (_form.NavHref ?? "").Trim(), _form.NavOrder)]
  };

  private static string[] Split(string? csv)
      => (csv ?? "").Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

  private static string Audience(ModuleRegistrationDto m)
      => m.LoadOnStartup ? "everyone"
         : m.AvailableToRoles.Length == 0 ? "every signed-in user"
         : string.Join(", ", m.AvailableToRoles);

  private static string FormatSize(long? bytes)
      => bytes switch
      {
        null => "",
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / 1024.0 / 1024.0:0.#} MB"
      };
}
