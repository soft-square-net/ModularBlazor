<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Administration area for ModularBlazor.BlzWebClient (layout "admin" from Layouts.Admin, a dependency):
      * /admin          overview, with links to the other admin pages;
      * /admin/members  members of a tenant, over the identity service's membership admin API
                        (/api/admin/tenants/{tenant}/members): list, invite, suspend, activate, remove.
    The host provides ModularBlazor.Abstractions (MudTailDataTable, MudTailRuntime, HttpClientNames), Microsoft.Extensions.Http
    and the WebAssembly authentication library, so those references stay private: the module ships as one .dll.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
