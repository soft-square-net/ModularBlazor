@page "/login"
@using soft.square.net.ModularBlazor.Abstractions.Api
@using soft.square.net.ModularBlazor.Abstractions.Auth
@attribute [UseLayout("auth")]
@inject IAuthenticationService authService
@inject IModuleNavigation Modules
@inject NavigationManager Nav

<PageTitle>Sign in</PageTitle>

<h2>Sign in</h2>
<p class="hint">Demo: any user name and password works. Sign in as <code>admin</code> to receive the admin modules.</p>

<form @onsubmit="SignInAsync" @onsubmit:preventDefault>
  <label for="user">User name</label>
  <input id="user" @bind="_userName" autocomplete="username" />

  <label for="password">Password</label>
  <input id="password" type="password" @bind="_password" autocomplete="current-password" />

  <label for="tenant">Tenant</label>
  <select id="tenant" type="password" @bind="_tenant" autocomplete="current-tenent">
      <optgroup>
          <option value="root" selected>root</option>
      </optgroup>
  </select>

  @if (_error is not null)
  {
    <p class="error-text">@_error</p>
  }

  <button type="submit" disabled="@_busy">@(_busy ? "Loading your modules…" : "Sign in")</button>
</form>

@code {
  [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

  private string _userName = "admin";
  private string _password = "123Pa$$word!";
  private string _tenant = "root";
  private string? _error;
  private bool _busy;

  private async Task SignInAsync()
  {
    _error = null;
    _busy = true;
    try
    {
      if (await authService.LoginAsync(_tenant, new LoginCommand() { UserName = _userName, Password = _password }))
      {
        await Modules.LoadUserModulesAsync("admin");
        Nav.NavigateTo(SafeReturnUrl(), replace: true);
      }
      else
      {
        _error = "Enter a user name and a password.";
      }
    }
    catch (Exception ex)
    {
      _error = $"Could not load your modules: {ex.Message}";
    }
    finally
    {
      _busy = false;
    }
  }

  // Only base-relative paths are accepted, so the query string can't redirect off-site.
  private string SafeReturnUrl()
      => ReturnUrl is { Length: > 0 } r && !r.StartsWith('/') && !r.StartsWith('\\') && !r.Contains(':')
          ? r
          : "";
}
